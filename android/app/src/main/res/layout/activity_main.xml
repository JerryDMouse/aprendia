<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aprendia_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bubble_user"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/aprendia_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/fredoka"
                android:text="AprendIA"
                android:textColor="@color/aprendia_ink"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/new_chat_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/pill_bg"
            android:fontFamily="@font/fredoka"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="&#9998; Nuevo chat"
            android:textAllCaps="false"
            android:textColor="@color/aprendia_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/messages_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mascot_image"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/mascot_bg"
                android:clipToOutline="true"
                android:contentDescription="Mascota de AprendIA"
                android:scaleType="centerCrop"
                android:src="@drawable/aprendia_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:text="Hola, soy AprendIA"
                android:textColor="@color/aprendia_ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:text="Pregunta lo que quieras aprender"
                android:textColor="@color/aprendia_muted"
                android:textSize="17sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/chips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_plants"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/chip_bg"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:padding="8dp"
                android:text="&#127793;\nPlantas"
                android:textColor="@color/aprendia_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_math"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/chip_bg"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:padding="8dp"
                android:text="&#10133;\nSumas"
                android:textColor="@color/aprendia_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_words"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/chip_bg"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:padding="8dp"
                android:text="&#128218;\nPalabras"
                android:textColor="@color/aprendia_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_water"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/chip_bg"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:padding="8dp"
                android:text="&#128167;\nCuidar el agua"
                android:textColor="@color/aprendia_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/composer_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <EditText
            android:id="@+id/question_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/fredoka"
            android:hint="Pregunta a AprendIA..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="3"
            android:textColor="@color/aprendia_ink"
            android:textColorHint="@color/aprendia_muted"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/mic_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/mic_button_bg"
            android:contentDescription="Hablar"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/aprendia_yellow_text" />

        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/send_button_bg"
            android:contentDescription="Enviar"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/aprendia_mint_text" />
    </LinearLayout>
</LinearLayout>